# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# The directory the editor loads the TypeScript language server from. It is
# a symlink to the tsrs binary, made by `bun run tsrs:tsdk`.
/.tsrs-tsdk/

# Regenerable CI artifacts (baseline.json stays tracked as the guard reference)
.bundle/size.json
.bundle/coverage-summary.json
.bundle/scripts-check/
.bundle/junit.xml
.bundle/lcov/

# production
/build

# misc
# Every flavour of the macOS metadata, not just the one `.DS_Store`:
# the `avalanche-preserved` copies and the `._` AppleDouble sidecars.
.DS_Store*
._*
*.pem

# IDE/Editor artifacts
.snapshots/
.trunk/logs/
.trunk/out/
.trunk/notifications/

# Kiro MCP config (contains secrets)
.kiro/settings/mcp.json

# env files - keep .env.local.example for documentation
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.preview
.env.test
.env.test.local
.env.vercel
.envrc
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
scripts/generate-favicons.js
tools/audit/target/
tools/probe/target/
supabase-mcp.json
supabase/.temp/
# The Supabase CLI's local branch state, written by `supabase start`.
supabase/.branches/

# editor/hand-rolled copies - never commit superseded source snapshots
*.backup
*.bak
*.orig
