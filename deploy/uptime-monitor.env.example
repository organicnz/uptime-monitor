# Environment for the uptime-monitor Bun container.
#
# Copy to ~/.config/uptime-monitor/env on the host and fill in the values:
#
#   mkdir -p ~/.config/uptime-monitor
#   cp deploy/uptime-monitor.env.example ~/.config/uptime-monitor/env
#   chmod 600 ~/.config/uptime-monitor/env
#
# The file holds live credentials, so it lives outside the repository and is
# never committed. `lib/env.ts` is the source of truth for which variables
# the app actually reads; `.env.local.example` documents them in full.

# Port the container listens on.
PORT=3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this deployment.
NEXT_PUBLIC_SITE_URL=

# Authenticates the cron endpoints (check-monitors, cleanup).
CRON_SECRET=

# Error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# QStash (optional)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Comma-separated user ids allowed to change the monitoring schedule.
ADMIN_USER_IDS=
