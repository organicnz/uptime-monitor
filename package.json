{
  "name": "uptime-monitor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.3-canary.20261019.1",
  "engines": {
    "bun": ">=1.4.4"
  },
  "trustedDependencies": [],
  "scripts": {
    "dev": "bun --bun next dev -p 3001",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun lint",
    "lint:fix": "bun lint --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "format:doctor": "bun fmt --doctor",
    "typecheck": "bun --bun tsrs --noEmit --checkerAssignment go",
    "typecheck:watch": "bun --bun tsrs --watch --noEmit --checkerAssignment go",
    "typecheck:lsp": "bun --bun tsrs --lsp -stdio",
    "test": "bun test __tests__",
    "test:unit": "bun test __tests__",
    "test:watch": "bun test --watch __tests__",
    "e2e": "bun --bun playwright test --project=chromium",
    "e2e:ci": "bun run e2e:preflight && E2E_PRODUCTION=1 bun --bun playwright test --project=chromium",
    "e2e:preflight": "bun scripts/e2e-preflight.ts",
    "e2e:install": "bun --bun playwright install chromium",
    "e2e:install:ci": "bun --bun playwright install --with-deps chromium",
    "e2e:seed": "bun scripts/e2e-seed.ts",
    "verify:delivery": "bun run doctor && bun run typecheck && bun run lint && bun run format:check && bun run coverage-check && bun run build && bun run bundle-size && bun run e2e:ci",
    "test:coverage": "bun scripts/coverage-check.ts",
    "audit": "bun scripts/audit.ts",
    "audit:report": "bun audit",
    "coverage-check": "bun scripts/coverage-check.ts",
    "bundle-size": "bun scripts/bundle-size.ts",
    "bundle-size:update": "bun scripts/bundle-size.ts --update",
    "prepare": "if [ -d .git ]; then bun --bun lefthook install; fi",
    "hooks:install": "if [ -d .git ]; then bun --bun lefthook install; fi",
    "hooks:uninstall": "if [ -d .git ]; then bun --bun lefthook uninstall; fi",
    "build:audit": "if [ -d .git ]; then git submodule update --init --recursive; fi; if command -v cargo > /dev/null; then cargo build --release --manifest-path tools/audit/Cargo.toml; elif [ ! -x tools/audit/target/release/audit ]; then exit 1; fi",
    "build:probe": "cargo build --release --locked --manifest-path tools/probe/Cargo.toml",
    "postinstall": "bun run build:audit && bun run build:probe",
    "doctor": "bun scripts/doctor.ts",
    "agent-docs:sync": "bun scripts/sync-agent-docs.ts",
    "bump:next-canary": "bun scripts/bump-next-canary.ts",
    "deps:outdated": "bun outdated",
    "deps:dedupe": "bun dedupe --dry-run",
    "audit:fix": "bun audit --fix",
    "verify:gpu": "bun --bun playwright test --project=chromium-gpu",
    "migrations:lint": "bun scripts/lint-migrations.ts",
    "supabase:migrate": "bun scripts/supabase-migrate.ts",
    "supabase:verify-schema": "bun scripts/supabase-verify-schema.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.87.0",
    "@upstash/qstash": "^2.8.4",
    "@vercel/analytics": "^1.6.1",
    "@webgpu/types": "^0.1.74",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.556.0",
    "next": "16.5.0-canary.20",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.68.0",
    "recharts": "^3.5.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vgpu": "^0.5.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "bun-types": "1.4.4-canary.20261019T141446",
    "happy-dom": "^20.14.3",
    "lefthook": "^2.0.9",
    "tailwindcss": "^4",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.1.0-beta"
  }
}
