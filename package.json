{
  "name": "uptime-monitor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test __tests__",
    "test:unit": "bun test __tests__",
    "e2e": "playwright test",
    "e2e:ci": "E2E_PRODUCTION=1 playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:install:ci": "playwright install --with-deps chromium",
    "e2e:seed": "bun scripts/e2e-seed.ts",
    "verify:delivery": "bun run typecheck && bun run lint && bun run format:check && bun run coverage-check && bun run build && bun run bundle-size && bun run e2e:ci",
    "test:coverage": "bun scripts/coverage-check.ts",
    "audit": "bun audit",
    "coverage-check": "bun scripts/coverage-check.ts",
    "bundle-size": "bun scripts/bundle-size.ts",
    "bundle-size:update": "bun scripts/bundle-size.ts --update",
    "prepare": "if [ -d .git ]; then lefthook install; fi",
    "hooks:install": "if [ -d .git ]; then lefthook install; fi",
    "hooks:uninstall": "if [ -d .git ]; then lefthook uninstall; fi",
    "build:audit": "if [ -d .git ]; then git submodule update --init --recursive; fi; if command -v cargo >/dev/null 2>&1; then (cd tools/audit && cargo build --release); elif [ ! -x tools/audit/target/release/audit ]; then exit 1; fi",
    "postinstall": "bun run build:audit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.87.0",
    "@upstash/qstash": "^2.8.4",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.556.0",
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.68.0",
    "recharts": "^3.5.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "undici": "8.10.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "bun-types": "^1.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "happy-dom": "^20.14.3",
    "jsdom": "^30.0.1",
    "lefthook": "^2.0.9",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
