# ============================================================================
# UPTIME MONITOR - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous (public) key - safe to expose to browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key - KEEP SECRET!
# Used for server-side operations that bypass RLS (cron jobs, admin tasks)
# ⚠️  NEVER expose this to the client/browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# APPLICATION CONFIGURATION (Required)
# ============================================================================

# Public URL of your deployed application (no trailing slash)
# Used for OAuth redirects and email links
# Development: http://localhost:3001
# Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Secret for authenticating cron job requests
# Generate a secure random string (minimum 32 characters):
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️  Keep this secret and use the same value in GitHub Actions secrets
CRON_SECRET=generate_a_secure_random_string_here
ADMIN_USER_IDS=user-uuid-1,user-uuid-2
# ============================================================================
# QSTASH CONFIGURATION (Optional)
# ============================================================================
# Alternative to GitHub Actions for cron jobs
# Get these from: https://console.upstash.com/qstash

# QSTASH_CURRENT_SIGNING_KEY=sig_...
# QSTASH_NEXT_SIGNING_KEY=sig_...
# QSTASH_TOKEN=signing_key_or_null   # optional: used by qstash provider

# ============================================================================
# EMAIL NOTIFICATIONS (Optional)
# ============================================================================
# For email notification channel support
# Get API key from: https://resend.com

# RESEND_API_KEY=re_...

# ============================================================================
# SENTRY CONFIGURATION (Required)
# ============================================================================
# Get your values from: https://sentry.io/docs/javascript/guides/nextjs/
# DSN: https://sentry.io/welcome/create/
NEXT_PUBLIC_SENTRY_DSN=https://your-organization@sentry.io/your-project
SENTRY_ORG=your-sentry-organization
SENTRY_PROJECT=your-sentry-project
# CI-only secret for source-map upload (GitHub Actions secret, never commit).
# Local builds work without it; upload is skipped gracefully.
# SENTRY_AUTH_TOKEN=sntrys_...

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Disable Next.js telemetry (optional)
# NEXT_TELEMETRY_DISABLED=1
