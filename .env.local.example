# ============================================================================
# UPTIME MONITOR - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# lib/env.ts is the single source of truth for which of these are required and
# which throw. __tests__/lib/env-doc.test.ts fails if this file drifts from it.
#
# Where each value has to exist:
#   .env.local                  local development
#   Vercel (runtime + build)    production / preview deployments
#   GitHub Actions secrets      CI only
#   GitHub Actions variables    CI only, non-sensitive
#   supabase secrets set        edge function secret store
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous (public) key - safe to expose to browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key - KEEP SECRET!
# Used for server-side operations that bypass RLS (cron jobs, notification
# delivery). Tenant notification credentials are NOT stored here: they live in
# Supabase Vault, reachable only through the notification_channel_* RPCs.
# ⚠️  NEVER expose this to the client/browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# APPLICATION CONFIGURATION (Required)
# ============================================================================

# Public URL of your deployed application (no trailing slash)
# Used for OAuth redirects and email links
# Development: http://localhost:3001
# Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Secret for authenticating cron job requests.
# Generate a secure random string (minimum 32 characters):
#   openssl rand -base64 32
# ⚠️  Vercel only. Not read by any GitHub Actions workflow.
CRON_SECRET=generate_a_secure_random_string_here

# Comma-separated user UUIDs allowed to change the global check schedule.
# Falls back to app_metadata.role === 'admin' when unset.
ADMIN_USER_IDS=user-uuid-1,user-uuid-2

# ============================================================================
# NOTIFICATION DISPATCH (Optional)
# ============================================================================
# Shared secret between the Next.js runtime and the
# supabase/functions/notification-dispatch Edge Function.
#
# Set it in three places with the SAME value:
#   - here (Vercel), so the test route may invoke the function
#   - GitHub Actions secret NOTIFICATION_DISPATCH_SECRET, so CI can run
#     `supabase secrets set`
#   - the function's own store, which CI provisions on every deploy
#
# The function reads it from the edge secret store, not from Vercel, which is
# what keeps tenant credentials out of the app runtime entirely. Unset means
# the test route sends in-process instead; the function itself fails closed
# with a 503 if its copy is missing.
# Generate with: openssl rand -base64 32
# NOTIFICATION_DISPATCH_SECRET=generate_a_secure_random_string_here

# ============================================================================
# QSTASH CONFIGURATION (Optional)
# ============================================================================
# Alternative to GitHub Actions for cron jobs. All three are required together
# when QStash is used: the cron route reads the signing keys without a default
# so a missing key fails loudly instead of silently rejecting every signature.
# Get these from: https://console.upstash.com/qstash

# QSTASH_CURRENT_SIGNING_KEY=sig_...
# QSTASH_NEXT_SIGNING_KEY=sig_...
# QSTASH_TOKEN=signing_key_or_null   # optional: used by qstash provider

# Bypass header for Vercel Deployment Protection on previews and tests.
# Needed by `bun run e2e:ci` against a protected deployment.
# Generate with: openssl rand -base64 32
# VERCEL_AUTOMATION_BYPASS_SECRET=generate_a_secure_random_string_here

# ============================================================================
# SENTRY CONFIGURATION (Required)
# ============================================================================
# Get your values from: https://sentry.io/docs/javascript/guides/nextjs/
# DSN: https://sentry.io/welcome/create/
NEXT_PUBLIC_SENTRY_DSN=https://your-organization@sentry.io/your-project
# Environment tag for browser-side Sentry events. `VERCEL_ENV` is not inlined
# into the client bundle (only `NEXT_PUBLIC_*` is), so the browser needs its own
# copy or client events are tagged "production" from a preview deploy.
# NEXT_PUBLIC_VERCEL_ENV=preview
SENTRY_ORG=your-sentry-organization
SENTRY_PROJECT=your-sentry-project
# CI-only secret for source-map upload (GitHub Actions secret, never commit).
# Local builds work without it; upload is skipped gracefully.
# SENTRY_AUTH_TOKEN=sntrys_...

# ============================================================================
# SUPABASE DELIVERY (CI only)
# ============================================================================
# Used by scripts/supabase-migrate.py and scripts/supabase-verify-schema.py, and
# by .github/workflows/supabase-migrations.yml. Not read by the app.
#
# SUPABASE_ACCESS_TOKEN  -> GitHub Actions SECRET
#   A personal access token (sbp_...). Org-scoped, not project-scoped: treat
#   its compromise as an account-level incident.
#   From: https://supabase.com/dashboard/account/tokens
#   SUPABASE_ACCESS_TOKEN=sbp_...
#
# SUPABASE_PROJECT_REF  -> GitHub Actions VARIABLE, not a secret
#   The subdomain of https://<ref>.supabase.co, already public via
#   NEXT_PUBLIC_SUPABASE_URL above.
#   SUPABASE_PROJECT_REF=your-project-id

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Disable Next.js telemetry (optional)
# NEXT_TELEMETRY_DISABLED=1
